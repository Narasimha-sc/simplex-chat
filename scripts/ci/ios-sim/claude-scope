# What claude-test.sh runs: one Claude session per layout (reachable, top), each with its cases, and each session's bounds.
# A case runs in both layouts only when the layouts render it differently; the rest run in one.
# entries-<layout> (optional) tells that session which directory entries and names its cases use, so none meets an entry already known.
# backend: yes when the cases use the test backend; a run that asks for Claude must then start it too.
backend: no
model: claude-haiku-5-5
layouts: reachable
cases-reachable: S2, S3, R12.4, R44.2, R44.1, R44.7, R44.3, R44.4, R44.8, R44.6, R12.3, S4, R12.1, R12.2, R12.7, R12.5, R12.11, R12.12, R12.8, R44.11, R44.10, R44.5, R44.9, R44.12
max-turns: 600
max-budget-usd: 5
